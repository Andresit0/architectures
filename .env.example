# Environment selection (dev / staging / production).
# Pass via --dart-define when running/building.
# Defaults to 'dev' if not provided.
#   flutter run --dart-define=ENVIRONMENT=staging
#   flutter run --dart-define=ENVIRONMENT=production
ENVIRONMENT=dev

# API host override (e.g. Android emulator: http://10.0.2.2).
# Pass via --dart-define when running/building.
#   flutter run --dart-define=API_HOST=10.0.2.2
# Defaults to 'localhost' (dev) if not provided.
API_HOST=localhost

# Force HTTPS for the API base URI even on a non-443 port (e.g. the web demo at
# https://tudesarrollador.com:5111). Pass via --dart-define when building/running.
#   flutter build web --dart-define=API_USE_HTTPS=true
# Defaults to false (HTTP is used unless the port is 443).
# API_USE_HTTPS=true

# Certificate pinning hashes (SHA-256).
# Pass via --dart-define when building for staging/production.
# Generate with:
#   openssl s_client -connect <host>:443 -servername <host> < /dev/null 2>/dev/null \
#     | openssl x509 -outform DER | openssl dgst -sha256
# Not used in local dev — leave commented out.
# PINNED_CERT_1=
# PINNED_CERT_2=
